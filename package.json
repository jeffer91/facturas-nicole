{
  "name": "nicole-facturador",
  "version": "0.1.0",
  "private": true,
  "description": "Nicole Encajes - aplicación de escritorio para preparar facturas",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check site/facturador/app.js",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ec.nicoleencajes.facturador",
    "productName": "Nicole Facturador",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "site/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
