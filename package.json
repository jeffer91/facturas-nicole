{
  "name": "nicole-facturador",
  "version": "0.2.0",
  "private": true,
  "description": "Nicole Encajes - facturación electrónica SRI en escritorio con firma P12/PFX",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/sri-service.cjs && node --check site/facturador/app.js",
    "dist": "npm run check && npm test && electron-builder --win nsis",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ec.nicoleencajes.facturador",
    "productName": "Nicole Facturador",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "site/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@ecuador-tax/core": "0.1.1",
    "@ecuador-tax/xml": "0.1.1",
    "@ecuador-tax/signature": "0.1.1",
    "@ecuador-tax/sri": "0.1.1",
    "pdfkit": "^0.17.2",
    "nodemailer": "^7.0.10"
  }
}
